{
  "manifest_version": 3,
  "name": "GPTWeb-Hub UI Preview",
  "version": "0.2.1",
  "description": "A visual preview of the GPTWeb-Hub Worker bridge panel.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:43821/*",
    "http://localhost:43821/*",
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*"
  ]
}
