{
  "manifest_version": 3,
  "name": "ProjectHub Managed Web Bridge",
  "version": "0.3.3",
  "description": "Bridge for ProjectHub-managed ChatGPT app windows.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:43821/*",
    "http://localhost:43821/*",
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*"
  ]
}
