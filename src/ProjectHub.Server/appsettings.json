{
  "LargeData": {
    "Issuer": "projecthub",
    "Audience": "projecthub-gateway",
    "GatewayUrl": "https://dfblackbox-nas.duckdns.org:8443/projecthub/",
    "StorageRoot": "",
    "MaxObjectSizeBytes": "1099511627776",
    "ChunkSizeBytes": "33554432"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5240",
  "ProjectHub": {
    "HeartbeatSeconds": 15,
    "OfflineSeconds": 60,
    "ActivityLeaseSeconds": 120
  },
  "Supabase": {
    "UrlEnvironmentVariable": "PROJECTHUB_SUPABASE_URL",
    "ServiceRoleKeyEnvironmentVariable": "PROJECTHUB_SUPABASE_SERVICE_ROLE_KEY"
  }
}
