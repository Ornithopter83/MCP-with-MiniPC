<Window x:Class="ProjectHub.Worker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectHub Worker"
        Width="1200" Height="1260" MinWidth="1100" MinHeight="1100"
        Background="#F7FAFF" Foreground="#12244C"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#12244C" />
    <SolidColorBrush x:Key="Muted" Color="#60728F" />
    <SolidColorBrush x:Key="Line" Color="#DCE6F3" />
    <SolidColorBrush x:Key="Blue" Color="#1477E8" />
    <SolidColorBrush x:Key="Green" Color="#0AA35A" />
    <SolidColorBrush x:Key="PaleBlue" Color="#EAF4FF" />
    <SolidColorBrush x:Key="PaleGreen" Color="#E9F8EF" />
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style x:Key="SectionBorder" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="8,7"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAF4FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEBFA"/></Trigger></Style.Triggers></Style>
    <ControlTemplate x:Key="ComboDropToggleTemplate" TargetType="ToggleButton"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" /></ControlTemplate>
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                <Grid>
                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                  <ToggleButton Height="32" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="0,0,10,0" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Template="{StaticResource ComboDropToggleTemplate}">
                    <TextBlock Text="⌄" FontSize="18" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                  </ToggleButton>
                </Grid>
              </Border>
              <Popup Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" PopupAnimation="Slide" StaysOpen="False" Panel.ZIndex="9999">
                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,4,0,0">
                  <ScrollViewer MaxHeight="960"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FlowArrowStyle" TargetType="TextBlock">
      <Setter Property="Text" Value=">>>" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Blue}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value><TranslateTransform X="0" /></Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.7" />
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="10" Duration="0:0:0.7" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="86" />
      <RowDefinition Height="122" />
      <RowDefinition Height="250" />
      <RowDefinition Height="300" />
      <RowDefinition Height="340" />
      <RowDefinition Height="0" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="60" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Border Width="62" Height="62" CornerRadius="14" Background="#1477E8" Margin="0,0,16,0">
          <Image Source="Assets/worker-icon.png" Width="68" Height="68" Stretch="Uniform" />
        </Border>
        <StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="ProjectHub Worker" FontSize="25" FontWeight="Bold" /><TextBlock x:Name="RepositoryNameText" Text=" · MCP-with-MiniPC" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,3,0,0" /></StackPanel>
          <TextBlock x:Name="PcNameText" Text="SUHO_DEV_PC" FontSize="16" Foreground="{StaticResource Muted}" Margin="4,5,0,0" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1" Content="⚙" FontSize="24" BorderThickness="0" Background="Transparent" Click="Settings_Click" Margin="0,4,0,0" />
    </Grid>    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
      <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="48" Height="48" Background="#F0F6FF" CornerRadius="12"><TextBlock Text="■" FontSize="27" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Codex" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="CodexConversationText" Visibility="Collapsed"/>
            <ComboBox x:Name="CodexThreadCombo" Width="238" Height="30" Margin="0,6,0,0" DisplayMemberPath="Label" SelectionChanged="CodexThreadCombo_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="ProjectStatusDot" Width="14" Height="14" Fill="#20C65A" Margin="0,0,8,0"/><TextBlock x:Name="ProjectStatusText" Text="READY" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource CardBorder}" Margin="4,0,4,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#F0F6FF" CornerRadius="12"><TextBlock Text="•••" FontSize="24" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="GPT Web" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="WebDescriptionText" Text="MCP 프로젝트 진척도 확인" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="WebStatusDot" Width="14" Height="14" Fill="#20C65A" Margin="0,0,8,0"/><TextBlock x:Name="WebStatusText" Text="READY" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel></StackPanel></Grid>
      </Border>
      <Border Style="{StaticResource CardBorder}" Margin="4,0,4,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#F0F6FF" CornerRadius="12"><TextBlock Text="▰" FontSize="28" Foreground="#40536E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Server" FontSize="16" FontWeight="Bold"/><TextBlock Text="MINIPC_SERVER" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="ServerStatusDot" Width="14" Height="14" Fill="#20C65A" Margin="0,0,8,0"/><TextBlock x:Name="ServerStatusText" Text="READY" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel></StackPanel></Grid>
      </Border>
    </UniformGrid>

    <Border Grid.Row="2" Style="{StaticResource SectionBorder}" Padding="16,10,16,10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="22" Margin="0,0,12,0"/><TextBlock Text="CURRENT TASK" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PaleBlue}" CornerRadius="12" Padding="20,15,20,12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.65*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><Border Width="52" Height="52" CornerRadius="28" Background="#2089E9"><TextBlock Text="→" FontSize="37" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="16,0,0,0"><TextBlock x:Name="TaskDirection" Text="IDLE" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="TaskTitle" Text="작업 없음" FontSize="20" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel><Grid Width="80" Height="80"><Border x:Name="CodexIconBackground" Width="80" Height="80" CornerRadius="40" Background="#98A5B5"/><Image x:Name="CodexInactiveIcon" Source="Assets/current-openai-gray.png" Width="68" Height="68" Stretch="Uniform"/><Image x:Name="CodexActiveIcon" Source="Assets/current-openai.png" Width="68" Height="68" Stretch="Uniform" Visibility="Collapsed"/></Grid><TextBlock x:Name="CodexLabelText" Text="CODEX" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,24,0,0"/><TextBlock x:Name="CodexStageText" Text="대기 중" FontSize="17" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel>
              <StackPanel x:Name="CodexToWorkerArrow" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center"><TextBlock x:Name="CodexArrow1" Text=">" FontSize="26" FontWeight="ExtraBold" Foreground="#B7C4D6"/><TextBlock x:Name="CodexArrow2" Text=">" FontSize="26" FontWeight="ExtraBold" Foreground="#B7C4D6"/><TextBlock x:Name="CodexArrow3" Text=">" FontSize="26" FontWeight="ExtraBold" Foreground="#B7C4D6"/></StackPanel>
              <StackPanel><Grid Width="80" Height="80"><Border x:Name="WorkerIconBackground" Width="80" Height="80" CornerRadius="40" Background="#98A5B5"/><Image x:Name="WorkerInactiveIcon" Source="Assets/current-console-gray.png" Width="68" Height="68" Stretch="Uniform" Visibility="Collapsed"/><Image x:Name="WorkerActiveIcon" Source="Assets/current-console.png" Width="68" Height="68" Stretch="Uniform"/></Grid><TextBlock x:Name="WorkerLabelText" Text="WORKER" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Green}" HorizontalAlignment="Center" Margin="0,24,0,0"/><TextBlock x:Name="WorkerStageText" Text="대기 중" FontSize="17" Foreground="{StaticResource Green}" HorizontalAlignment="Center"/></StackPanel>
              <StackPanel x:Name="WorkerToWebArrow" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center"><TextBlock x:Name="WebArrow1" Text=">" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource Blue}"/><TextBlock x:Name="WebArrow2" Text=">" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource Blue}"/><TextBlock x:Name="WebArrow3" Text=">" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource Blue}"/></StackPanel>
              <StackPanel><Grid Width="80" Height="80"><Border x:Name="WebIconBackground" Width="80" Height="80" CornerRadius="40" Background="#98A5B5"/><Image x:Name="WebInactiveIcon" Source="Assets/current-web-gray.png" Width="68" Height="68" Stretch="Uniform" Visibility="Collapsed"/><Image x:Name="WebActiveIcon" Source="Assets/current-web.png" Width="68" Height="68" Stretch="Uniform"/></Grid><TextBlock x:Name="WebLabelText" Text="GPT WEB" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" Margin="0,24,0,0"/><TextBlock x:Name="WebStageText" Text="대기 중" FontSize="17" Foreground="{StaticResource Blue}" HorizontalAlignment="Center"/></StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource SectionBorder}" Padding="16,9,16,10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="▥" FontSize="21" Margin="0,0,12,0"/><TextBlock Text="MESSAGE" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal"><Button x:Name="CodexTab" Content="&lt;/&gt;  Codex" Width="220" Height="44" FontSize="17" Click="CodexTab_Click" Foreground="{StaticResource Blue}" FontWeight="Bold"/><Button x:Name="WebTab" Content="●  GPT Web" Width="220" Height="44" FontSize="17" Margin="8,0,0,0" Click="WebTab_Click"/></StackPanel><Border Grid.Row="2" Background="{StaticResource PaleGreen}" CornerRadius="11" Padding="18,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ResultTitle" Text="Codex 결과 대기 중" FontSize="19" FontWeight="Bold"/><TextBlock Text="아직 실행된 작업이 없습니다." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock x:Name="ResultBody" Text="새 작업을 실행하면 결과가 이 영역에 표시됩니다." FontSize="16" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Grid></Border></Grid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource SectionBorder}" Padding="16,10,16,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="➤" FontSize="21" Margin="0,0,12,0"/><TextBlock Text="COMMAND" FontSize="17" FontWeight="Bold"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,6,0,10">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,5">
    <Grid>
      <TextBlock Text="CLI COMMAND" Margin="14,7,14,0" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
      <TextBox x:Name="CommandInput" Margin="0,22,0,0" Padding="14,7" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource Muted}" Text="CLI에 즉시 전달할 작업 지시..." BorderThickness="0" GotFocus="CommandInput_GotFocus" LostFocus="CommandInput_LostFocus"/>
    </Grid>
  </Border>
  <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,5,0,0">
    <Grid>
      <TextBlock Text="GPT WEB INSTRUCTION" Margin="14,7,14,0" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
      <TextBox x:Name="WebInstructionInput" Margin="0,22,0,0" Padding="14,7" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource Muted}" Text="CLI 답변 뒤에 붙여 GPT Web에 전달할 지침..." BorderThickness="0" GotFocus="WebInstructionInput_GotFocus" LostFocus="WebInstructionInput_LostFocus"/>
    </Grid>
  </Border>
</Grid>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="152"/><ColumnDefinition Width="100"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="UsageText" Grid.Column="0" Text="5시간/주간 제한: CLI 미제공 · 이번 작업 누적: 0 토큰" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
          <ComboBox x:Name="ModelCombo" Grid.Column="1" Height="34" Margin="8,0,8,0" SelectedIndex="3">
            <ComboBoxItem Content="GPT-5.6 Sol" />
            <ComboBoxItem Content="GPT-6 Astra" />
            <ComboBoxItem Content="GPT-5.6 Terra" />
            <ComboBoxItem Content="GPT-5.6 Luna" />
          </ComboBox>
          <ComboBox x:Name="ReasoningCombo" Grid.Column="2" Height="34" Margin="0,0,16,0" SelectedIndex="1">
            <ComboBoxItem Content="Minimal" />
            <ComboBoxItem Content="Medium" />
            <ComboBoxItem Content="High" />
          </ComboBox>
          <Button x:Name="ClearButton" Grid.Column="3" Content="▥  Clear" Height="34" Click="Clear_Click"/>
          <Button x:Name="RunButton" Grid.Column="4" Content="▶  Run Task" Height="34" Margin="8,0,0,0" Background="{StaticResource Blue}" Foreground="White" BorderBrush="{StaticResource Blue}" FontWeight="Bold" Click="RunTask_Click"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
