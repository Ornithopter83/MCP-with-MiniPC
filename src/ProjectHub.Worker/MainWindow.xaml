<Window x:Class="ProjectHub.Worker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectHub Worker"
        Icon="pack://application:,,,/ProjectHub.Worker;component/Assets/worker-icon.png"
        Width="1400" Height="900" MinWidth="1180" MinHeight="820" MaxWidth="1440" MaxHeight="960"
        Background="#F7FAFF" Foreground="#12244C"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#12244C" />
    <SolidColorBrush x:Key="Muted" Color="#60728F" />
    <SolidColorBrush x:Key="Line" Color="#DCE6F3" />
    <SolidColorBrush x:Key="Blue" Color="#1477E8" />
    <SolidColorBrush x:Key="Green" Color="#0AA35A" />
    <SolidColorBrush x:Key="PaleBlue" Color="#EAF4FF" />
    <SolidColorBrush x:Key="PaleGreen" Color="#E9F8EF" />
    <SolidColorBrush x:Key="ActiveMessageTab" Color="#B9DEFF" />
    <SolidColorBrush x:Key="InactiveMessageTab" Color="#F4F9FF" />
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style x:Key="SectionBorder" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="8,7"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAF4FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEBFA"/></Trigger></Style.Triggers></Style>
    <ControlTemplate x:Key="ComboDropToggleTemplate" TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsHitTestVisible="False" /></Border></ControlTemplate>
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                <Grid>
                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                  <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="0,0,10,0" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Template="{StaticResource ComboDropToggleTemplate}">
                    <TextBlock Text="⌄" FontSize="18" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                  </ToggleButton>
                </Grid>
              </Border>
              <Popup Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" PopupAnimation="Slide" StaysOpen="False" Panel.ZIndex="9999">
                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,4,0,0">
                  <ScrollViewer MaxHeight="960"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FlowArrowStyle" TargetType="TextBlock">
      <Setter Property="Text" Value=">>>" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Blue}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value><TranslateTransform X="0" /></Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.7" />
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="10" Duration="0:0:0.7" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="86" />
      <RowDefinition Height="250" />
      <RowDefinition x:Name="MessageRow" Height="52" />
      <RowDefinition x:Name="CommandRow" Height="*" />
      <RowDefinition Height="0" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="60" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Border Width="62" Height="62" CornerRadius="14" Background="#1477E8" Margin="0,0,16,0">
          <Image Source="Assets/worker-icon.png" Width="68" Height="68" Stretch="Uniform" />
        </Border>
        <StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="ProjectHub Worker" FontSize="25" FontWeight="Bold" /><TextBlock x:Name="RepositoryNameText" Text=" · MCP-with-MiniPC" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,3,0,0" /></StackPanel>
          <TextBlock x:Name="PcNameText" Text="SUHO_DEV_PC" FontSize="16" Foreground="{StaticResource Muted}" Margin="4,5,0,0" />
        </StackPanel>
      </StackPanel>
      <Button x:Name="SettingsButton" Grid.Column="1" Content="⚙" FontSize="24" BorderThickness="0" Background="Transparent" Click="Settings_Click" Margin="0,4,0,0" />
    </Grid>    <Popup x:Name="StatusPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" HorizontalOffset="-1360" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Slide" Panel.ZIndex="9999">
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Width="1400" Height="850" MaxHeight="850" Margin="0,8,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
    <Border Background="White" Height="30" Cursor="SizeAll" MouseLeftButtonDown="SettingsPopupHeader_MouseLeftButtonDown" MouseMove="SettingsPopupHeader_MouseMove" MouseLeftButtonUp="SettingsPopupHeader_MouseLeftButtonUp">
      <TextBlock Text="AI 모델 설정" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="2,0,0,4" VerticalAlignment="Center"/>
    </Border>
    <Grid Margin="0,0,0,12" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="48" Height="48" Background="#F0F6FF" CornerRadius="12"><TextBlock Text="■" FontSize="27" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Codex" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="CodexConversationText" Visibility="Collapsed"/>
            <ComboBox x:Name="CodexThreadCombo" Style="{x:Null}" Width="420" Height="34" Margin="0,6,0,0" DisplayMemberPath="Label" SelectionChanged="CodexThreadCombo_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="ProjectStatusDot" Width="14" Height="14" Fill="#20C65A" Margin="0,0,8,0"/><TextBlock x:Name="ProjectStatusText" Text="READY" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0,4,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#F0F6FF" CornerRadius="12"><Image Source="Assets/current-web.png" Width="38" Height="38" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="GPT Web" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="WebDescriptionText" Text="MCP 프로젝트 진척도 확인" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="WebStatusDot" Width="14" Height="14" Fill="#20C65A" Margin="0,0,8,0"/><TextBlock x:Name="WebStatusText" Text="READY" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel></StackPanel></Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="4,0,4,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#F0F6FF" CornerRadius="12"><TextBlock Text="▰" FontSize="28" Foreground="#40536E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Server" FontSize="16" FontWeight="Bold"/><TextBlock Text="MINIPC_SERVER" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="ServerStatusDot" Width="14" Height="14" Fill="#20C65A" Margin="0,0,8,0"/><TextBlock x:Name="ServerStatusText" Text="READY" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel></StackPanel></Grid>
      </Border>
    </Grid>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="저장소 및 폴더" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Git 저장소" Width="140" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="RepositoryUrlInput" Width="800" Height="36" FontSize="16" Padding="9,5" IsReadOnly="True" IsEnabled="False" IsTabStop="False" ToolTip="작업 폴더의 Git origin에서 자동으로 확인됩니다."/>
            <Button Content="자동 확인" Margin="10,0,0,0" Padding="14,6" FontSize="15" Click="AutoDetectTargets_Click"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="140,7,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TargetGitStateText" FontSize="15" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TargetPathText" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="서버 주소" Width="140" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="ServerUrlInput" Width="780" Height="36" FontSize="16" Padding="9,5"/>
            <Border Width="390" Height="110" Margin="14,0,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,12" Background="#F8FBFF">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="64" Height="72" Background="#EAF4FF" CornerRadius="10" VerticalAlignment="Center"><StackPanel Margin="12,15"><Border Height="10" Margin="0,0,0,4" Background="#334A68" CornerRadius="2"/><Border Height="10" Margin="0,0,0,4" Background="#334A68" CornerRadius="2"/><Border Height="10" Background="#334A68" CornerRadius="2"/></StackPanel></Border><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="서버" FontSize="17" FontWeight="Bold"/><TextBlock Text="MINIPC_SERVER" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse x:Name="ServerStatusDotSettings" Width="11" Height="11" Fill="#20C65A" Margin="0,0,7,0"/><TextBlock x:Name="ServerStatusTextSettings" Text="READY" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel></StackPanel></Grid>
            </Border>
          </StackPanel>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="작업 폴더" Width="140" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="WorkingDirectoryInput" Width="800" Height="36" FontSize="16" Padding="9,5"/>
            <Button x:Name="WorkingDirectoryBrowseButton" Content="폴더 선택…" Margin="10,0,0,0" Padding="14,6" FontSize="15" Click="BrowseWorkingDirectory_Click"/>
          </StackPanel>
          <Border Grid.Row="5" BorderBrush="#C9DBF5" BorderThickness="1" CornerRadius="7" Background="#F5F9FF" Padding="14,12" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="AI모델 설정" FontSize="16" FontWeight="Bold"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="실행 방식" Width="140" FontSize="15" VerticalAlignment="Center"/>
                <ComboBox x:Name="ExecutionModeCombo" Style="{x:Null}" Width="300" Height="34" FontSize="15" SelectionChanged="ExecutionModeCombo_SelectionChanged">
                  <ComboBoxItem Content="관제 우선 CLI → CLI" Tag="CLI_TO_CLI"/>
                  <ComboBoxItem Content="기존 Codex → GPT Web" Tag="LEGACY_WEB"/>
                </ComboBox>
                <TextBlock x:Name="AiRolesStatusText" Margin="16,0,0,0" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
              <Border BorderBrush="#DCE6F3" BorderThickness="1" CornerRadius="7" Background="White" Padding="8,6" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="설계·관제 AI" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/><Border Width="48" Height="48" Margin="0,8,0,0" Background="#101820"><Border.OpacityMask><ImageBrush ImageSource="Assets/current-openai.png" Stretch="Uniform"/></Border.OpacityMask></Border></StackPanel>
                  <Grid Grid.Column="1" Margin="0,0,14,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="서비스 제공자" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                      <ToggleButton x:Name="CoordinatorWebTabButton" Content="GPT Web" Width="150" Height="34" IsChecked="True" Click="CoordinatorWebTab_Click"/>
                      <ToggleButton x:Name="CoordinatorCliTabButton" Content="OpenAI Codex CLI" Width="190" Height="34" Click="CoordinatorCliTab_Click"/>
                    </StackPanel>
                    <ComboBox x:Name="CoordinatorProviderCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Height="34" Visibility="Collapsed" SelectionChanged="CoordinatorProviderCombo_SelectionChanged"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="모델" VerticalAlignment="Center" Margin="0,8,0,0"/>
                    <ComboBox x:Name="CoordinatorModelCombo" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,4,8,0" SelectionChanged="RoleModelCombo_SelectionChanged"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="추론" FontSize="14" VerticalAlignment="Center" Margin="0,4,0,0"/>
                    <ComboBox x:Name="CoordinatorReasoningCombo" Grid.Row="1" Grid.Column="3" Height="32" Margin="0,4,0,0"/>
                  </Grid>
                  <Grid Grid.Column="2">
                    <Border x:Name="CoordinatorWebCard" Width="350" HorizontalAlignment="Right" Background="#F4F9FF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10">
                      <StackPanel Orientation="Horizontal"><Image Source="Assets/current-web.png" Width="46" Height="46" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="GPT Web" FontSize="15" FontWeight="Bold"/><TextBlock Text="웹 대화 연결 상태를 사용합니다" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
                    </Border>
                    <Border x:Name="CoordinatorCliCard" Width="350" HorizontalAlignment="Right" Background="#F4F9FF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal"><Border Width="42" Height="36" BorderBrush="{StaticResource Blue}" BorderThickness="2" CornerRadius="6" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{StaticResource Blue}" Margin="2,0"/><Ellipse Width="5" Height="5" Fill="{StaticResource Blue}" Margin="2,0"/><Ellipse Width="5" Height="5" Fill="{StaticResource Blue}" Margin="2,0"/></StackPanel></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Codex 스레드 선택" FontWeight="Bold"/><ComboBox x:Name="CoordinatorRoleThreadCombo" Width="260" Height="30" DisplayMemberPath="Label"/></StackPanel></StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
              <Border BorderBrush="#DCE6F3" BorderThickness="1" CornerRadius="7" Background="White" Padding="8,6" Margin="0,6,0,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="170"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="작업 AI" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/><Border Width="48" Height="48" Margin="0,8,0,0" Background="#101820"><Border.OpacityMask><ImageBrush ImageSource="Assets/current-openai.png" Stretch="Uniform"/></Border.OpacityMask></Border></StackPanel>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="서비스 제공자" VerticalAlignment="Center"/>
                  <ComboBox x:Name="ImplementerProviderCombo" Grid.Row="0" Grid.Column="2" Height="32"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="모델" VerticalAlignment="Center" Margin="0,8,0,0"/>
                  <ComboBox x:Name="ImplementerModelCombo" Grid.Row="1" Grid.Column="2" Height="32" Margin="0,4,8,0" SelectionChanged="RoleModelCombo_SelectionChanged"/>
                  <TextBlock Grid.Row="1" Grid.Column="3" Text="추론" FontSize="14" VerticalAlignment="Center" Margin="0,4,0,0"/>
                  <ComboBox x:Name="ImplementerReasoningCombo" Grid.Row="1" Grid.Column="4" Height="32" Margin="0,4,0,0"/>
                  <Border Grid.Column="5" Grid.RowSpan="2" Width="350" HorizontalAlignment="Right" Background="#F4F9FF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <StackPanel Orientation="Horizontal"><Border Width="36" Height="30" BorderBrush="{StaticResource Blue}" BorderThickness="2" CornerRadius="6" Margin="0,0,8,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="4" Height="4" Fill="{StaticResource Blue}" Margin="2,0"/><Ellipse Width="4" Height="4" Fill="{StaticResource Blue}" Margin="2,0"/><Ellipse Width="4" Height="4" Fill="{StaticResource Blue}" Margin="2,0"/></StackPanel></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Codex 스레드 선택" FontWeight="Bold"/><ComboBox x:Name="ImplementerRoleThreadCombo" Width="260" Height="30" DisplayMemberPath="Label"/></StackPanel></StackPanel>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border Grid.Row="6" BorderBrush="#C9DBF5" BorderThickness="1" CornerRadius="7" Background="#F5F9FF" Padding="14,12" Margin="0,6,0,0">
            <Grid Background="White">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="170"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="고수준 작업 AI" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/><Border Width="48" Height="48" Margin="0,8,0,0" Background="#101820"><Border.OpacityMask><ImageBrush ImageSource="Assets/current-openai.png" Stretch="Uniform"/></Border.OpacityMask></Border></StackPanel>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="서비스 제공자" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="OpenAI Codex CLI" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
              <TextBlock Grid.Row="0" Grid.Column="3" Text="사용 여부" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <CheckBox x:Name="HighLevelEnabledCheckBox" Grid.Row="0" Grid.Column="4" Content="사용" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="모델" VerticalAlignment="Center" Margin="0,8,0,0"/>
              <ComboBox x:Name="HighLevelModelCombo" Grid.Row="1" Grid.Column="2" Height="32" Margin="0,4,8,0" SelectionChanged="RoleModelCombo_SelectionChanged"/>
              <TextBlock Grid.Row="1" Grid.Column="3" Text="추론" FontSize="14" VerticalAlignment="Center" Margin="0,4,0,0"/>
              <ComboBox x:Name="HighLevelReasoningCombo" Grid.Row="1" Grid.Column="4" Height="32" Margin="0,4,0,0"/>
              <Border Grid.Column="5" Grid.RowSpan="2" Width="350" HorizontalAlignment="Right" Background="#F4F9FF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8">
                <StackPanel Orientation="Horizontal"><Border Width="36" Height="30" BorderBrush="{StaticResource Blue}" BorderThickness="2" CornerRadius="6" Margin="0,0,8,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="4" Height="4" Fill="{StaticResource Blue}" Margin="2,0"/><Ellipse Width="4" Height="4" Fill="{StaticResource Blue}" Margin="2,0"/><Ellipse Width="4" Height="4" Fill="{StaticResource Blue}" Margin="2,0"/></StackPanel></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Codex 스레드 선택" FontWeight="Bold"/><ComboBox x:Name="HighLevelRoleThreadCombo" Width="260" Height="30" DisplayMemberPath="Label"/></StackPanel></StackPanel>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Row="7" BorderBrush="#C9DBF5" BorderThickness="1" CornerRadius="7" Background="#F5F9FF" Padding="14,12" Margin="0,6,0,0">
            <Grid Background="White">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="170"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="판단 AI" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/><Image Source="Assets/current-jev.png" Width="48" Height="48" Margin="0,8,0,0"/></StackPanel>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="서비스 제공자" VerticalAlignment="Center"/>
              <ComboBox x:Name="JudgeProviderCombo" Grid.Row="0" Grid.Column="2" Height="32" FontSize="14"><ComboBoxItem Content="Typesafe" Tag="jev"/></ComboBox>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="모델" VerticalAlignment="Center" Margin="0,4,0,0"/>
              <ComboBox x:Name="JudgeModelCombo" Grid.Row="1" Grid.Column="2" Height="32" FontSize="14" Margin="0,4,0,0" SelectedIndex="0"><ComboBoxItem Content="JEV"/></ComboBox>
              <TextBlock Grid.Row="0" Grid.Column="3" Text="사용 여부" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <CheckBox x:Name="EnableJudgeCheckBox" Grid.Row="0" Grid.Column="4" Content="사용" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <TextBlock x:Name="JudgeSettingsStatusText" Grid.Row="1" Grid.Column="4" Text="Typesafe · JEV · 사용 안 함" Visibility="Collapsed"/>
              <Button Grid.Row="0" Grid.Column="5" Grid.RowSpan="2" Content="JSON 설정 테스트" Width="350" HorizontalAlignment="Right" Padding="18,10" MinHeight="44" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Blue}" Background="#EAF4FF" BorderBrush="{StaticResource Blue}" BorderThickness="1" Click="TestJudge_Click"/>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Text="서비스 제공자" Width="140" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Text="제한 시간" Margin="26,0,0,0" Width="82" FontSize="15" VerticalAlignment="Center"/>
                <TextBox x:Name="JudgeTimeoutInput" Width="80" Height="32" FontSize="15" Padding="8,4" IsReadOnly="False" IsEnabled="True" IsHitTestVisible="True" Focusable="True" IsTabStop="True" MaxLength="3" Background="White" Foreground="{StaticResource Ink}" HorizontalContentAlignment="Right" PreviewTextInput="JudgeTimeoutInput_PreviewTextInput" GotFocus="JudgeTimeoutInput_GotFocus" LostFocus="JudgeTimeoutInput_LostFocus" ToolTip="10~600초"/>
                <TextBlock Text="sec" Margin="8,0,0,0" FontSize="15" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Text="접속 주소" Width="140" FontSize="15" VerticalAlignment="Center"/>
                <TextBox x:Name="JudgeExecutableInput" Width="620" Height="32" FontSize="15" Padding="8,4" ToolTip="기본값: https://api.typesafe.ai/v1/systemone"/>
                <Button Content="Test" Margin="10,0,0,0" Padding="18,5" FontSize="14" Click="TestJudge_Click"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
        </StackPanel>
        </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="닫기" Padding="18,7" FontSize="15" Click="CloseSettings_Click"/>
            <Button Content="적용" Margin="10,0,0,0" Padding="20,7" FontSize="15" Background="{StaticResource Blue}" Foreground="White" BorderBrush="{StaticResource Blue}" Click="SaveTargetSettings_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Popup>
    <Border x:Name="SettingsDimOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="100" IsHitTestVisible="True"/>

    <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Padding="16,10,16,10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="22" Margin="0,0,12,0"/><TextBlock Text="CURRENT TASK" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PaleBlue}" CornerRadius="12" Padding="20,15,20,12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.65*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><Border Width="52" Height="52" CornerRadius="28" Background="#2089E9"><TextBlock Text="→" FontSize="37" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="16,0,0,0">
                <TextBlock x:Name="TaskDirection" Text="IDLE" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="TaskTitle" Text="작업 없음" FontSize="20" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Ellipse x:Name="JudgePulseDot" Width="10" Height="10" Fill="#A6B4C5" VerticalAlignment="Center"/>
                  <TextBlock x:Name="JudgeFlowText" Text="JUDGE · OFF" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="7,0,0,0"/>
                </StackPanel>
              </StackPanel></StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
              <StackPanel Width="132">
                <Grid Width="100" Height="100" HorizontalAlignment="Center">
                  <Border x:Name="LeftNodeBackground" Width="100" Height="100" CornerRadius="50" Background="#748598"/>
                  <Image x:Name="LeftJudgeGrayIcon" Source="Assets/current-jev-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftJudgeColorIcon" Source="Assets/current-jev.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftCodexGrayIcon" Source="Assets/current-openai-gray.png" Width="84" Height="84" Stretch="Uniform"/>
                  <Image x:Name="LeftCodexColorIcon" Source="Assets/current-openai.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftWorkerGrayIcon" Source="Assets/current-console-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftWorkerColorIcon" Source="Assets/current-console.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftWebGrayIcon" Source="Assets/current-web-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftWebColorIcon" Source="Assets/current-web.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="FlowLeftLabel" Text="CODEX" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="FlowLeftStage" Text="대기 중" FontSize="16" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <TextBlock x:Name="FlowArrow1" Text="&gt;" FontSize="30" FontWeight="ExtraBold" Foreground="#96C6FD"/>
                <TextBlock x:Name="FlowArrow2" Text="&gt;" FontSize="30" FontWeight="ExtraBold" Foreground="#96C6FD"/>
                <TextBlock x:Name="FlowArrow3" Text="&gt;" FontSize="30" FontWeight="ExtraBold" Foreground="#96C6FD"/>
              </StackPanel>
              <StackPanel Width="132">
                <Grid Width="100" Height="100" HorizontalAlignment="Center">
                  <Border x:Name="RightNodeBackground" Width="100" Height="100" CornerRadius="50" Background="#748598"/>
                  <Image x:Name="RightJudgeGrayIcon" Source="Assets/current-jev-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightJudgeColorIcon" Source="Assets/current-jev.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightCodexGrayIcon" Source="Assets/current-openai-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightCodexColorIcon" Source="Assets/current-openai.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightWorkerGrayIcon" Source="Assets/current-console-gray.png" Width="84" Height="84" Stretch="Uniform"/>
                  <Image x:Name="RightWorkerColorIcon" Source="Assets/current-console.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightWebGrayIcon" Source="Assets/current-web-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightWebColorIcon" Source="Assets/current-web.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="FlowRightLabel" Text="WORKER" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="FlowRightStage" Text="대기 중" FontSize="16" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
              </StackPanel>
            </StackPanel>

          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="MessageSection" Grid.Row="2" Style="{StaticResource SectionBorder}" Padding="16,9,16,10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Button x:Name="MessageToggleButton" Grid.Row="0" Content="▥  MESSAGE  ▼" HorizontalContentAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="Bold" Click="MessageToggle_Click"/>
        <Grid x:Name="MessageContentGrid" Grid.Row="1" Grid.RowSpan="2">
          <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal"><Button x:Name="CodexTab" Content="&lt;/&gt;  Codex" Width="220" Height="44" FontSize="17" Click="CodexTab_Click" Foreground="{StaticResource Blue}" FontWeight="Bold"/><Button x:Name="WebTab" Content="●  GPT Web" Width="220" Height="44" FontSize="17" Margin="8,0,0,0" Click="WebTab_Click"/></StackPanel>
          <Border Grid.Row="1" Background="{StaticResource PaleGreen}" CornerRadius="11" Padding="18,14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock x:Name="ResultTitle" Text="MESSAGE LOG · Codex" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="작업 메시지가 도착한 순서대로 이어집니다." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>
                <TextBlock x:Name="ResultBody" Visibility="Collapsed"/>
              </StackPanel>
              <Grid Grid.Row="1">
                <TextBlock x:Name="MessageLogEmptyText" Text="새 작업을 실행하면 이곳에 누적 로그가 표시됩니다." FontSize="16" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2"/>
                <ListBox x:Name="MessageLogList" Background="Transparent" BorderThickness="0" ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=MessageLogItems}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" FontSize="16" Foreground="{StaticResource Ink}">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0,0,0,14"/>
                      <Setter Property="Focusable" Value="False"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Border x:Name="CommandSection" Grid.Row="3" Style="{StaticResource SectionBorder}" Padding="16,10,16,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition x:Name="CommandControlsRow" Height="38"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="➤" FontSize="21" Margin="0,0,12,0"/><TextBlock Text="COMMAND" FontSize="17" FontWeight="Bold"/></StackPanel>
        <Grid x:Name="CommandTextGrid" Grid.Row="1" Margin="0,6,0,10">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,5">
    <Grid>
      <TextBlock Text="CLI COMMAND" Margin="14,7,14,0" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
      <TextBox x:Name="CommandInput" Margin="0,22,0,0" Padding="14,7" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource Muted}" Text="CLI에 즉시 전달할 작업 지시..." BorderThickness="0" GotFocus="CommandInput_GotFocus" LostFocus="CommandInput_LostFocus"/>
    </Grid>
  </Border>
  <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,5,0,0">
    <Grid>
      <TextBlock Text="GPT WEB INSTRUCTION" Margin="14,7,14,0" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
      <TextBox x:Name="WebInstructionInput" Margin="0,22,0,0" Padding="14,7" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource Muted}" Text="CLI 답변 뒤에 붙여 GPT Web에 전달할 지침..." BorderThickness="0" GotFocus="WebInstructionInput_GotFocus" LostFocus="WebInstructionInput_LostFocus"/>
    </Grid>
  </Border>
</Grid>
        <Grid x:Name="CommandControlsGrid" Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="152"/><ColumnDefinition Width="100"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="UsageText" Grid.Column="0" Text="5시간/주간 제한: CLI 미제공 · 이번 작업 누적: 0 토큰" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
          <ComboBox x:Name="ModelCombo" Grid.Column="1" Height="34" Margin="8,0,8,0" SelectedIndex="0">
            <ComboBoxItem Content="GPT-6 Luna" />
            <ComboBoxItem Content="GPT-6 Sol" />
            <ComboBoxItem Content="GPT-6 Astra" />
            <ComboBoxItem Content="GPT-5.6 Luna" />
            <ComboBoxItem Content="GPT-5.6 Terra" />
            <ComboBoxItem Content="GPT-5.6 Sol" />
            <ComboBoxItem Content="GPT-5.5" />
          </ComboBox>
          <ComboBox x:Name="ReasoningCombo" Grid.Column="2" Height="34" Margin="0,0,16,0" SelectedIndex="1">
            <ComboBoxItem Content="Minimal" />
            <ComboBoxItem Content="Medium" />
            <ComboBoxItem Content="High" />
          </ComboBox>
          <Button x:Name="ClearButton" Grid.Column="3" Content="▥  Clear" Height="34" Click="Clear_Click"/>
          <Button x:Name="RunButton" Grid.Column="4" Content="▶  Run Task" Height="34" Margin="8,0,0,0" Background="{StaticResource Blue}" Foreground="White" BorderBrush="{StaticResource Blue}" FontWeight="Bold" Click="RunTask_Click"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
