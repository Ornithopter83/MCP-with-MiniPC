<Window x:Class="ProjectHub.Worker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectHub"
        Icon="pack://application:,,,/ProjectHub.Worker;component/Assets/worker-icon.png"
        Width="1400" Height="900" MinWidth="1180" MinHeight="820" MaxWidth="1440" MaxHeight="960"
        Background="#F7FAFF" Foreground="#12244C"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#12244C" />
    <SolidColorBrush x:Key="Muted" Color="#60728F" />
    <SolidColorBrush x:Key="Line" Color="#DCE6F3" />
    <SolidColorBrush x:Key="Blue" Color="#1477E8" />
    <SolidColorBrush x:Key="Green" Color="#0AA35A" />
    <SolidColorBrush x:Key="PaleBlue" Color="#EAF4FF" />
    <SolidColorBrush x:Key="PaleGreen" Color="#E9F8EF" />
    <SolidColorBrush x:Key="ActiveMessageTab" Color="#B9DEFF" />
    <SolidColorBrush x:Key="InactiveMessageTab" Color="#F4F9FF" />
    <DropShadowEffect x:Key="RunButtonShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#1477E8" />
    <DropShadowEffect x:Key="PipelineGoldGlow" BlurRadius="11" ShadowDepth="0" Opacity="0.40" Color="#FFC84A" />
    <Style x:Key="PipelineActiveOutline" TargetType="Rectangle">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="#806F5315" />
      <Setter Property="StrokeThickness" Value="3" />
      <Setter Property="RadiusX" Value="10" />
      <Setter Property="RadiusY" Value="10" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Panel.ZIndex" Value="5" />
    </Style>
    <Style x:Key="PipelineActiveOrbit" TargetType="Rectangle" BasedOn="{StaticResource PipelineActiveOutline}">
      <Setter Property="Stroke" Value="#FFFFD76A" />
      <Setter Property="StrokeThickness" Value="4" />
      <Setter Property="StrokeDashArray" Value="2 8" />
      <Setter Property="StrokeDashCap" Value="Round" />
      <Setter Property="Effect" Value="{StaticResource PipelineGoldGlow}" />
    </Style>
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style x:Key="SectionBorder" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="8,7"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAF4FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEBFA"/></Trigger></Style.Triggers></Style>
    <ControlTemplate x:Key="ComboDropToggleTemplate" TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsHitTestVisible="False" /></Border></ControlTemplate>
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                <Grid>
                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                  <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Padding="0,0,10,0" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Template="{StaticResource ComboDropToggleTemplate}">
                    <TextBlock Text="⌄" FontSize="18" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                  </ToggleButton>
                </Grid>
              </Border>
              <Popup Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" PopupAnimation="Slide" StaysOpen="False" Panel.ZIndex="9999">
                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,4,0,0">
                  <ScrollViewer MaxHeight="960"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FlowArrowStyle" TargetType="TextBlock">
      <Setter Property="Text" Value=">>>" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Blue}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value><TranslateTransform X="0" /></Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.7" />
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="10" Duration="0:0:0.7" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid Margin="24,17,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="96" />
      <RowDefinition Height="220" />
      <RowDefinition Height="*" />
      <RowDefinition Height="100" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource SectionBorder}" Padding="20,12" Margin="0,0,10,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="프로젝트" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="작업 폴더" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="서버 주소" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="DashboardProjectText" Text="ProjectHub" FontSize="15"/><TextBlock x:Name="DashboardFolderText" Text="작업 폴더 확인 중" FontSize="15" Margin="0,6,0,0"/><TextBlock x:Name="DashboardServerUrlText" Text="서버 주소 확인 중" FontSize="15" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource SectionBorder}" Padding="14,10" Margin="0,0,10,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="68" Height="68" Background="#EAF4FF" CornerRadius="9" VerticalAlignment="Center" Padding="8">
            <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <Border Margin="0,1" Background="#334A68" CornerRadius="2"><Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="4" Height="4" Fill="#20C65A" VerticalAlignment="Center"/><Ellipse Grid.Column="1" Width="4" Height="4" Fill="#4DABFF" VerticalAlignment="Center"/><Border Grid.Column="2" Width="15" Height="2" Background="#DCEBFA" VerticalAlignment="Center"/></Grid></Border>
              <Border Grid.Row="1" Margin="0,1" Background="#334A68" CornerRadius="2"><Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="4" Height="4" Fill="#20C65A" VerticalAlignment="Center"/><Ellipse Grid.Column="1" Width="4" Height="4" Fill="#4DABFF" VerticalAlignment="Center"/><Border Grid.Column="2" Width="15" Height="2" Background="#DCEBFA" VerticalAlignment="Center"/></Grid></Border>
              <Border Grid.Row="2" Margin="0,1" Background="#334A68" CornerRadius="2"><Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="4" Height="4" Fill="#20C65A" VerticalAlignment="Center"/><Ellipse Grid.Column="1" Width="4" Height="4" Fill="#4DABFF" VerticalAlignment="Center"/><Border Grid.Column="2" Width="15" Height="2" Background="#DCEBFA" VerticalAlignment="Center"/></Grid></Border>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="서버" FontSize="18" FontWeight="Bold"/><TextBlock Text="MINIPC_SERVER" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Ellipse x:Name="ServerStatusDot" Width="12" Height="12" Fill="#A6B4C5" Margin="0,0,7,0"/><TextBlock x:Name="ServerStatusText" Text="확인 중" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
        </Grid>
      </Border>
      <Button x:Name="SettingsButton" Grid.Column="2" Click="Settings_Click" ToolTip="설정" Padding="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand">
        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="SettingsButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="⚙" FontSize="29" HorizontalAlignment="Center"/><TextBlock Text="설정" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-2,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SettingsButtonBorder" Property="Background" Value="#EAF4FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
      </Button>
    </Grid>
    <TextBlock x:Name="RepositoryNameText" Visibility="Collapsed"/><TextBlock x:Name="PcNameText" Visibility="Collapsed"/>
    <Popup x:Name="StatusPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" HorizontalOffset="-1360" VerticalOffset="-60" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Slide" Panel.ZIndex="9999">
      <Border x:Name="SettingsPopupBorder" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Width="1400" Height="850" MaxHeight="850" Margin="0,8,0,0" PreviewKeyDown="SettingsPopup_PreviewKeyDown">
        <Border.Resources>
          <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
          </Style>
        </Border.Resources>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>
    <Border Background="White" Height="30" Cursor="SizeAll" MouseLeftButtonDown="SettingsPopupHeader_MouseLeftButtonDown" MouseMove="SettingsPopupHeader_MouseMove" MouseLeftButtonUp="SettingsPopupHeader_MouseLeftButtonUp">
      <TextBlock Text="AI 모델 설정" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="2,0,0,4" VerticalAlignment="Center"/>
    </Border>
    <Grid Margin="0,0,0,12" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="48" Height="48" Background="#F0F6FF" CornerRadius="12"><TextBlock Text="■" FontSize="27" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Codex" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="CodexConversationText" Visibility="Collapsed"/>
            <ComboBox x:Name="CodexThreadCombo" Style="{x:Null}" Width="420" Height="34" Margin="0,6,0,0" DisplayMemberPath="Label" SelectionChanged="CodexThreadCombo_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="ProjectStatusDot" Width="14" Height="14" Fill="#20C65A" Margin="0,0,8,0"/><TextBlock x:Name="ProjectStatusText" Text="READY" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0,4,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#F0F6FF" CornerRadius="12"><Image Source="Assets/current-web.png" Width="38" Height="38" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="GPT Web" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="WebDescriptionText" Text="MCP 프로젝트 진척도 확인" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="WebStatusDot" Width="14" Height="14" Fill="#20C65A" Margin="0,0,8,0"/><TextBlock x:Name="WebStatusText" Text="READY" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel></StackPanel></Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="4,0,4,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#F0F6FF" CornerRadius="12"><TextBlock Text="▰" FontSize="28" Foreground="#40536E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Server" FontSize="16" FontWeight="Bold"/><TextBlock Text="MINIPC_SERVER" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="LegacyServerStatusDot" Width="14" Height="14" Fill="#20C65A" Margin="0,0,8,0"/><TextBlock x:Name="LegacyServerStatusText" Text="READY" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel></StackPanel></Grid>
      </Border>
    </Grid>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="저장소 및 폴더" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Git 저장소" Width="140" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="RepositoryUrlInput" Width="800" Height="36" FontSize="16" Padding="9,5" IsReadOnly="True" IsEnabled="False" IsTabStop="False" ToolTip="작업 폴더의 Git origin에서 자동으로 확인됩니다."/>
            <Button Content="자동 확인" Margin="10,0,0,0" Padding="14,6" FontSize="15" Click="AutoDetectTargets_Click"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="140,7,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TargetGitStateText" FontSize="15" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TargetPathText" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="서버 주소" Width="140" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="ServerUrlInput" Width="780" Height="36" FontSize="16" Padding="9,5"/>
            <Border Width="390" Height="110" Margin="14,0,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,12" Background="#F8FBFF">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="64" Height="72" Background="#EAF4FF" CornerRadius="10" VerticalAlignment="Center" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border Grid.Row="0" Margin="0,1" Background="#334A68" CornerRadius="3"><Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="4" Height="4" Fill="#20C65A" VerticalAlignment="Center"/><Ellipse Grid.Column="1" Width="4" Height="4" Fill="#4DABFF" VerticalAlignment="Center"/><Border Grid.Column="2" Width="15" Height="2" Background="#DCEBFA" VerticalAlignment="Center"/></Grid></Border><Border Grid.Row="1" Margin="0,1" Background="#334A68" CornerRadius="3"><Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="4" Height="4" Fill="#20C65A" VerticalAlignment="Center"/><Ellipse Grid.Column="1" Width="4" Height="4" Fill="#4DABFF" VerticalAlignment="Center"/><Border Grid.Column="2" Width="15" Height="2" Background="#DCEBFA" VerticalAlignment="Center"/></Grid></Border><Border Grid.Row="2" Margin="0,1" Background="#334A68" CornerRadius="3"><Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="4" Height="4" Fill="#20C65A" VerticalAlignment="Center"/><Ellipse Grid.Column="1" Width="4" Height="4" Fill="#4DABFF" VerticalAlignment="Center"/><Border Grid.Column="2" Width="15" Height="2" Background="#DCEBFA" VerticalAlignment="Center"/></Grid></Border></Grid></Border><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="서버" FontSize="17" FontWeight="Bold"/><TextBlock Text="MINIPC_SERVER" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse x:Name="ServerStatusDotSettings" Width="11" Height="11" Fill="#20C65A" Margin="0,0,7,0"/><TextBlock x:Name="ServerStatusTextSettings" Text="READY" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Green}"/></StackPanel></StackPanel></Grid>
            </Border>
          </StackPanel>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="작업 폴더" Width="140" FontSize="15" VerticalAlignment="Center"/>
            <TextBox x:Name="WorkingDirectoryInput" Width="800" Height="36" FontSize="16" Padding="9,5"/>
            <Button x:Name="WorkingDirectoryBrowseButton" Content="폴더 선택…" Margin="10,0,0,0" Padding="14,6" FontSize="15" Click="BrowseWorkingDirectory_Click"/>
          </StackPanel>
          <Border Grid.Row="5" BorderBrush="#C9DBF5" BorderThickness="1" CornerRadius="7" Background="#F5F9FF" Padding="14,12" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="AI모델 설정" FontSize="16" FontWeight="Bold"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="실행 방식" Width="140" FontSize="15" VerticalAlignment="Center"/>
                <ComboBox x:Name="ExecutionModeCombo" Style="{x:Null}" Width="300" Height="34" FontSize="15" SelectionChanged="ExecutionModeCombo_SelectionChanged">
                  <ComboBoxItem Content="관제 우선 CLI → CLI" Tag="CLI_TO_CLI"/>
                  <ComboBoxItem Content="기존 Codex → GPT Web" Tag="LEGACY_WEB"/>
                </ComboBox>
                <TextBlock x:Name="AiRolesStatusText" Margin="16,0,0,0" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
              <Border BorderBrush="#DCE6F3" BorderThickness="1" CornerRadius="7" Background="White" Padding="8,6" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="설계·관제 AI" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Border x:Name="CoordinatorProviderIconCircle" Width="52" Height="52" Background="#1477E8" CornerRadius="26">
                      <Image x:Name="CoordinatorProviderIcon" Source="Assets/current-openai.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </StackPanel>
                  <Grid Grid.Column="1" Margin="0,0,14,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="실행 대상" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CoordinatorTargetCombo" Grid.Row="0" Grid.Column="1" Height="34" SelectionChanged="CoordinatorTargetCombo_SelectionChanged">
                      <ComboBoxItem Content="ChatGPT Web" Tag="web"/>
                      <ComboBoxItem Content="CLI Provider" Tag="cli"/>
                    </ComboBox>
                    <Grid x:Name="CoordinatorCliOptionsPanel" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="서비스 제공자" VerticalAlignment="Center"/>
                      <ComboBox x:Name="CoordinatorProviderCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Height="32" SelectionChanged="RoleProviderCombo_SelectionChanged"/>
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="모델" VerticalAlignment="Center" Margin="0,8,0,0"/>
                      <ComboBox x:Name="CoordinatorModelCombo" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,4,8,0" SelectionChanged="RoleModelCombo_SelectionChanged"/>
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="추론" FontSize="14" VerticalAlignment="Center" Margin="0,4,0,0"/>
                      <ComboBox x:Name="CoordinatorReasoningCombo" Grid.Row="1" Grid.Column="3" Height="32" Margin="0,4,0,0"/>
                    </Grid>
                  </Grid>
                  <Grid Grid.Column="2">
                    <Border x:Name="CoordinatorWebCard" Width="350" HorizontalAlignment="Right" Background="#F4F9FF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="Assets/current-web.png" Width="46" Height="46" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="ChatGPT Web" FontSize="14" FontWeight="Bold"/>
                          <TextBlock x:Name="CoordinatorWebBindingStatusText" Text="HQ Web 미연결" FontSize="12" FontWeight="SemiBold" Foreground="OrangeRed" Margin="0,3,0,0"/>
