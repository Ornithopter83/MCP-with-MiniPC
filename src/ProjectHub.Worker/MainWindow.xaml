        <ColumnDefinition Width="270"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="DashboardPreflightText" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="6,0,12,0"/>
      <StackPanel x:Name="DirectWorkOptionsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,10,0">
        <StackPanel Margin="0,0,6,0">
          <TextBlock Text="서비스 제공사" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,2"/>
          <ComboBox x:Name="DirectWorkProviderCombo" Width="150" Height="34" SelectionChanged="DirectWorkProviderCombo_SelectionChanged"/>
        </StackPanel>
        <StackPanel Margin="0,0,6,0">
          <TextBlock Text="모델" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,2"/>
          <ComboBox x:Name="DirectWorkModelCombo" Width="230" Height="34" SelectionChanged="DirectWorkModelCombo_SelectionChanged"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="추론 깊이" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,2"/>
          <ComboBox x:Name="DirectWorkReasoningCombo" Width="110" Height="34" SelectionChanged="DirectWorkReasoningCombo_SelectionChanged"/>
        </StackPanel>
      </StackPanel>
      <CheckBox x:Name="DirectWorkModeCheckBox" Grid.Column="2" Content="계약문서 무시" IsChecked="False" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Checked="DirectWorkModeCheckBox_Changed" Unchecked="DirectWorkModeCheckBox_Changed" ToolTip="ProjectHub 역할 계약과 프로젝트 AGENTS 지침 주입 없이 현재 작업 폴더에서 선택한 모델을 직접 실행합니다."/>
      <Button x:Name="AddWorkButton" Grid.Column="4" Content="＋   작업 추가" Width="266" Height="70" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#168A4A" Foreground="White" BorderBrush="#168A4A" FontSize="25" FontWeight="Bold" IsEnabled="False" Visibility="Collapsed" Click="AddWorkButton_Click">
        <Button.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#168A4A"/></Button.Effect>
      </Button>
      <Button x:Name="RunButton" Grid.Column="6" Content="▶   실행" Width="266" Height="70" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1477E8" Foreground="White" BorderBrush="#1477E8" FontSize="27" FontWeight="Bold" IsEnabled="False" Click="RunTask_Click" Effect="{StaticResource RunButtonShadow}"/>
    </Grid>

    <Grid Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Padding="16,10,16,10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="22" Margin="0,0,12,0"/><TextBlock Text="CURRENT TASK" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PaleBlue}" CornerRadius="12" Padding="20,15,20,12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.65*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><Border Width="52" Height="52" CornerRadius="28" Background="#2089E9"><TextBlock Text="→" FontSize="37" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="16,0,0,0">
                <TextBlock x:Name="TaskDirection" Text="IDLE" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="TaskTitle" Text="작업 없음" FontSize="20" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Ellipse x:Name="JudgePulseDot" Width="10" Height="10" Fill="#A6B4C5" VerticalAlignment="Center"/>
                  <TextBlock x:Name="JudgeFlowText" Text="JUDGE · OFF" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="7,0,0,0"/>
                </StackPanel>
              </StackPanel></StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
              <StackPanel Width="132">
                <Grid Width="100" Height="100" HorizontalAlignment="Center">
                  <Border x:Name="LeftNodeBackground" Width="100" Height="100" CornerRadius="50" Background="#748598"/>
                  <Image x:Name="LeftJudgeGrayIcon" Source="Assets/current-jev-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftJudgeColorIcon" Source="Assets/current-jev.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftCodexGrayIcon" Source="Assets/current-openai-gray.png" Width="84" Height="84" Stretch="Uniform"/>
                  <Image x:Name="LeftCodexColorIcon" Source="Assets/current-openai.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftWorkerGrayIcon" Source="Assets/current-console-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftWorkerColorIcon" Source="Assets/current-console.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftWebGrayIcon" Source="Assets/current-web-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="LeftWebColorIcon" Source="Assets/current-web.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="FlowLeftLabel" Text="CODEX" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="FlowLeftStage" Text="대기 중" FontSize="16" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <TextBlock x:Name="FlowArrow1" Text="&gt;" FontSize="30" FontWeight="ExtraBold" Foreground="#96C6FD"/>
                <TextBlock x:Name="FlowArrow2" Text="&gt;" FontSize="30" FontWeight="ExtraBold" Foreground="#96C6FD"/>
                <TextBlock x:Name="FlowArrow3" Text="&gt;" FontSize="30" FontWeight="ExtraBold" Foreground="#96C6FD"/>
              </StackPanel>
              <StackPanel Width="132">
                <Grid Width="100" Height="100" HorizontalAlignment="Center">
                  <Border x:Name="RightNodeBackground" Width="100" Height="100" CornerRadius="50" Background="#748598"/>
                  <Image x:Name="RightJudgeGrayIcon" Source="Assets/current-jev-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightJudgeColorIcon" Source="Assets/current-jev.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightCodexGrayIcon" Source="Assets/current-openai-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightCodexColorIcon" Source="Assets/current-openai.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightWorkerGrayIcon" Source="Assets/current-console-gray.png" Width="84" Height="84" Stretch="Uniform"/>
                  <Image x:Name="RightWorkerColorIcon" Source="Assets/current-console.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightWebGrayIcon" Source="Assets/current-web-gray.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                  <Image x:Name="RightWebColorIcon" Source="Assets/current-web.png" Width="84" Height="84" Stretch="Uniform" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="FlowRightLabel" Text="WORKER" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="FlowRightStage" Text="대기 중" FontSize="16" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
              </StackPanel>
            </StackPanel>

          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="MessageSection" Grid.Row="2" Style="{StaticResource SectionBorder}" Padding="16,9,16,10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Button x:Name="MessageToggleButton" Grid.Row="0" Content="▥  MESSAGE  ▼" HorizontalContentAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" FontSize="16" FontWeight="Bold" Click="MessageToggle_Click"/>
        <Grid x:Name="MessageContentGrid" Grid.Row="1" Grid.RowSpan="2">
          <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal"><Button x:Name="CodexTab" Content="&lt;/&gt;  Codex" Width="220" Height="44" FontSize="17" Click="CodexTab_Click" Foreground="{StaticResource Blue}" FontWeight="Bold"/><Button x:Name="WebTab" Content="●  GPT Web" Width="220" Height="44" FontSize="17" Margin="8,0,0,0" Click="WebTab_Click"/></StackPanel>
          <Border Grid.Row="1" Background="{StaticResource PaleGreen}" CornerRadius="11" Padding="18,14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock x:Name="ResultTitle" Text="MESSAGE LOG · Codex" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="작업 메시지가 도착한 순서대로 이어집니다." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>
                <TextBlock x:Name="ResultBody" Visibility="Collapsed"/>
              </StackPanel>
              <Grid Grid.Row="1">
                <TextBlock x:Name="MessageLogEmptyText" Text="새 작업을 실행하면 이곳에 누적 로그가 표시됩니다." FontSize="16" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2"/>
                <ListBox x:Name="MessageLogList" Background="Transparent" BorderThickness="0" ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=MessageLogItems}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" FontSize="16" Foreground="{StaticResource Ink}">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0,0,0,14"/>
                      <Setter Property="Focusable" Value="False"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Border x:Name="CommandSection" Grid.Row="3" Style="{StaticResource SectionBorder}" Padding="16,10,16,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition x:Name="CommandControlsRow" Height="38"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="➤" FontSize="21" Margin="0,0,12,0"/><TextBlock Text="COMMAND" FontSize="17" FontWeight="Bold"/></StackPanel>
        <Grid x:Name="CommandTextGrid" Grid.Row="1" Margin="0,6,0,10">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,5">
    <Grid>
      <TextBlock Text="CLI COMMAND" Margin="14,7,14,0" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
      <TextBox x:Name="CommandInput" Margin="0,22,0,0" Padding="14,7" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource Muted}" Text="CLI에 즉시 전달할 작업 지시..." BorderThickness="0" GotFocus="CommandInput_GotFocus" LostFocus="CommandInput_LostFocus"/>
    </Grid>
  </Border>
  <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,5,0,0">
    <Grid>
      <TextBlock Text="GPT WEB INSTRUCTION" Margin="14,7,14,0" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
      <TextBox x:Name="WebInstructionInput" Margin="0,22,0,0" Padding="14,7" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource Muted}" Text="CLI 답변 뒤에 붙여 GPT Web에 전달할 지침..." BorderThickness="0" GotFocus="WebInstructionInput_GotFocus" LostFocus="WebInstructionInput_LostFocus"/>
    </Grid>
  </Border>
</Grid>
        <Grid x:Name="CommandControlsGrid" Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="152"/><ColumnDefinition Width="100"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="UsageText" Grid.Column="0" Text="5시간/주간 제한: CLI 미제공 · 이번 작업 누적: 0 토큰" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
          <ComboBox x:Name="ModelCombo" Grid.Column="1" Height="34" Margin="8,0,8,0" SelectedIndex="0">
            <ComboBoxItem Content="GPT-6 Luna" />
            <ComboBoxItem Content="GPT-6 Sol" />
            <ComboBoxItem Content="GPT-6 Astra" />
            <ComboBoxItem Content="GPT-5.6 Luna" />
            <ComboBoxItem Content="GPT-5.6 Terra" />
            <ComboBoxItem Content="GPT-5.6 Sol" />
            <ComboBoxItem Content="GPT-5.5" />
          </ComboBox>
          <ComboBox x:Name="ReasoningCombo" Grid.Column="2" Height="34" Margin="0,0,16,0" SelectedIndex="1">
            <ComboBoxItem Content="Minimal" />
            <ComboBoxItem Content="Medium" />
            <ComboBoxItem Content="High" />
          </ComboBox>
          <Button x:Name="ClearButton" Grid.Column="3" Content="▥  Clear" Height="34" Click="Clear_Click"/>
          <Button x:Name="LegacyRunButton" Grid.Column="4" Content="▶  Run Task" Height="34" Margin="8,0,0,0" Background="{StaticResource Blue}" Foreground="White" BorderBrush="{StaticResource Blue}" FontWeight="Bold" Click="RunTask_Click"/>
        </Grid>
      </Grid>
    </Border>
    </Grid>
  </Grid>
</Window>
