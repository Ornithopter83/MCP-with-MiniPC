<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\worker-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\worker-icon.png" />
    <Resource Include="Assets\current-openai.png" />
    <Resource Include="Assets\current-console.png" />
    <Resource Include="Assets\current-web.png" />
    <Resource Include="Assets\current-openai-gray.png" />
    <Resource Include="Assets\current-console-gray.png" />
    <Resource Include="Assets\current-web-gray.png" />
    <Content Include="Assets\worker-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>



