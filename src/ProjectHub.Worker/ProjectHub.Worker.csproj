<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\worker-icon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(IncludeNativeLibrariesForSelfExtract)' == ''">true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\bin\</PublishDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\worker-icon.png" />
    <Resource Include="Assets\current-openai.png" />
    <Resource Include="Assets\current-console.png" />
    <Resource Include="Assets\current-muse.png" />
    <Resource Include="Assets\current-web.png" />
    <Resource Include="Assets\current-openai-gray.png" />
    <Resource Include="Assets\current-console-gray.png" />
    <Resource Include="Assets\current-web-gray.png" />
    <Content Include="Assets\worker-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\..\extension\gptweb-hub\manifest.json">
      <LogicalName>ProjectHub.Worker.Extension.manifest.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\extension\gptweb-hub\content.js">
      <LogicalName>ProjectHub.Worker.Extension.content.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\extension\gptweb-hub\background.js">
      <LogicalName>ProjectHub.Worker.Extension.background.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Contracts\HQ-ROUTING-CONTRACT.md">
      <LogicalName>ProjectHub.Worker.Contracts.HQ-ROUTING-CONTRACT.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Contracts\WORK-ROUTING-CONTRACT.md">
      <LogicalName>ProjectHub.Worker.Contracts.WORK-ROUTING-CONTRACT.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Contracts\MANAGER-ROUTING-CONTRACT.md">
      <LogicalName>ProjectHub.Worker.Contracts.MANAGER-ROUTING-CONTRACT.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Contracts\QA-ROUTING-CONTRACT.md">
      <LogicalName>ProjectHub.Worker.Contracts.QA-ROUTING-CONTRACT.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Contracts\HIGH-ROUTING-CONTRACT.md">
      <LogicalName>ProjectHub.Worker.Contracts.HIGH-ROUTING-CONTRACT.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
